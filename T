class ScenarioRunner : public QObject {
    Q_OBJECT
public:
    // action MLI sur un ampli : "demarrer_mli", "pause_mli", "reprendre_mli", "arreter_mli"
    using MliHook = std::function<bool(int amp, const QString& action, QString* err)>;
    explicit ScenarioRunner(QObject* parent = nullptr);
    ~ScenarioRunner() override;
    void setMliHook(MliHook h) { m_mli = std::move(h); }
    bool running() const { return m_running; }
    void run(const QJsonObject& automation, int scenarioIndex, const QString& dev6528, bool simulate);
    void stop(const QString& why);                       // arret demande par l'utilisateur
signals:
    void stepStarted(int index, const QString& text);
    void logMessage(const QString& level, const QString& message);
    void finished(bool ok, const QString& message);
private:
    void next();
    void execStep();
    void stepDone();
    void fail(const QString& msg);
    void safeStop();
    void setAllOutputs(const char* field);
    EaPsu* psu(const QString& id, QString* err);
    QJsonObject find(const QString& list, const QJsonValue& id) const;
    QString stepText(const QJsonObject& st) const;

    MliHook m_mli;
    QJsonObject m_auto; QJsonArray m_steps; QString m_name, m_dev;
    bool m_sim = false, m_running = false;
    int m_k = -1;
    QTimer m_wait, m_poll;
    QElapsedTimer m_pollClock; double m_timeoutS = 0; int m_expected = 0; int m_inVoie = 0; bool m_continueOnTimeout = false;
    QMap<QString, std::shared_ptr<EaPsu>> m_psus;
    QSet<int> m_amps;                                    // amplis vises par le scenario (arret de securite)
};








// v58 : moteur d'execution des scenarios
#include "ScenarioRunner.h"
#include "ScenarioHardware.h"
#include "ScenarioPages.h"

ScenarioRunner::ScenarioRunner(QObject* parent) : QObject(parent)
{
    m_wait.setSingleShot(true);
    connect(&m_wait, &QTimer::timeout, this, &ScenarioRunner::stepDone);
    m_poll.setInterval(50);
    connect(&m_poll, &QTimer::timeout, this, [this]() {
        int v = 0; QString e;
        if (!Scen6528::read(m_dev, m_inVoie, &v, m_sim, &e)) { m_poll.stop(); fail(e); return; }
        if (m_sim && m_pollClock.elapsed() > 500) v = m_expected;          // simulation : l'etat attendu arrive apres 0,5 s
        if (v == m_expected) { m_poll.stop(); emit logMessage("ok", QString("Entrée voie %1 = %2").arg(m_inVoie).arg(v)); stepDone(); return; }
        if (m_pollClock.elapsed() > m_timeoutS * 1000) {
            m_poll.stop();
            if (m_continueOnTimeout) { emit logMessage("warn", QString("Délai dépassé (%1 s) sur l’entrée voie %2 : on continue").arg(m_timeoutS).arg(m_inVoie)); stepDone(); }
            else fail(QString("délai dépassé (%1 s) : l’entrée voie %2 n’a pas pris l’état %3").arg(m_timeoutS).arg(m_inVoie).arg(m_expected));
        }
    });
}

ScenarioRunner::~ScenarioRunner() { if (m_running) safeStop(); }

QJsonObject ScenarioRunner::find(const QString& list, const QJsonValue& id) const
{
    const QString t = ScenarioModel::idText(id);
    for (const auto& v : m_auto.value(list).toArray()) if (ScenarioModel::idText(v.toObject().value("id")) == t) return v.toObject();
    return QJsonObject();
}

QString ScenarioRunner::stepText(const QJsonObject& st) const
{
    const int a = ScenarioAction::find(st.value("action").toString());
    QString t = a >= 0 ? ScenarioAction::all()[a].label : st.value("action").toString();
    if (a >= 0) {
        const auto& d = ScenarioAction::all()[a];
        if (d.target == ScenarioAction::Amp) t += QString(" · Ampli %1").arg(ScenarioModel::idText(st.value("cible")));
        if (d.target == ScenarioAction::Out) t += " · " + find("sorties", st.value("cible")).value("nom").toString();
        if (d.target == ScenarioAction::In)  t += " · " + find("entrees", st.value("cible")).value("nom").toString();
        if (d.target == ScenarioAction::Psu) t += " · " + find("alimentations", st.value("cible")).value("nom").toString();
        if (d.value != ScenarioAction::NoValue) t += " · " + QString::number(st.value("valeur").toDouble(), 'g', 6);
    }
    return t;
}

void ScenarioRunner::run(const QJsonObject& automation, int idx, const QString& dev6528, bool simulate)
{
    if (m_running) return;
    const QJsonArray sc = automation.value("scenarios").toArray();
    if (idx < 0 || idx >= sc.size()) { emit finished(false, "aucun scénario sélectionné"); return; }
    m_auto = automation; m_steps = sc[idx].toObject().value("etapes").toArray(); m_name = sc[idx].toObject().value("nom").toString();
    m_dev = dev6528.trimmed(); m_sim = simulate; m_k = -1; m_psus.clear(); m_amps.clear();
    if (m_steps.isEmpty()) { emit finished(false, "le scénario n’a pas d’étape"); return; }
    if (!m_sim && m_dev.isEmpty()) { emit finished(false, "nom NI MAX du PXIe-6528 non renseigné"); return; }
    for (const auto& v : m_steps) { const QJsonObject st = v.toObject(); const int a = ScenarioAction::find(st.value("action").toString());
        if (a >= 0 && ScenarioAction::all()[a].target == ScenarioAction::Amp) m_amps << ScenarioModel::idText(st.value("cible")).toInt(); }
    m_running = true;
    emit logMessage("info", QString("Scénario « %1 » : début (%2 étapes)%3").arg(m_name).arg(m_steps.size()).arg(m_sim ? " — SIMULATION, aucun matériel piloté" : ""));
    setAllOutputs("initial");
    if (m_running) next();
}

void ScenarioRunner::next()
{
    if (!m_running) return;
    if (++m_k >= m_steps.size()) {
        setAllOutputs("fin");
        for (auto& p : m_psus) p->close();               // rend la main en local ; les sorties DC gardent leur etat
        m_psus.clear(); m_running = false; m_k = -1;
        emit logMessage("ok", QString("Scénario « %1 » terminé").arg(m_name));
        emit finished(true, QString("Scénario « %1 » terminé").arg(m_name));
        return;
    }
    QTimer::singleShot(0, this, &ScenarioRunner::execStep);
}

void ScenarioRunner::stepDone() { if (m_running) next(); }

EaPsu* ScenarioRunner::psu(const QString& id, QString* err)
{
    if (m_psus.contains(id)) return m_psus[id].get();
    const QJsonObject o = find("alimentations", QJsonValue(id));
    if (o.isEmpty()) { *err = "alimentation introuvable"; return nullptr; }
    auto p = std::make_shared<EaPsu>();
    if (!p->open(o.value("connexion_usb").toString(), m_sim, err)) { *err = o.value("nom").toString() + " : " + *err; return nullptr; }
    emit logMessage("info", QString("%1 connectée sur %2").arg(o.value("nom").toString(), o.value("connexion_usb").toString()));
    m_psus[id] = p; return p.get();
}

void ScenarioRunner::execStep()
{
    if (!m_running) return;
    const QJsonObject st = m_steps[m_k].toObject();
    const QString text = stepText(st);
    emit stepStarted(m_k, text);
    emit logMessage("info", QString("Étape %1 : %2").arg(m_k + 1).arg(text));
    const int a = ScenarioAction::find(st.value("action").toString());
    if (a < 0) { fail(QString("action non reconnue « %1 »").arg(st.value("action").toString())); return; }
    const QString key = ScenarioAction::all()[a].key;
    const double val = st.value("valeur").toDouble();
    QString err;

    if (key.endsWith("_mli")) {
        const int amp = ScenarioModel::idText(st.value("cible")).toInt();
        if (m_sim) { stepDone(); return; }
        if (!m_mli) { fail("pilotage des MLI indisponible"); return; }
        if (!m_mli(amp, key, &err)) { fail(QString("Ampli %1 : %2").arg(amp).arg(err)); return; }
        stepDone(); return;
    }
    if (key == "positionner_sortie_6528") {
        const QJsonObject o = find("sorties", st.value("cible"));
        if (o.isEmpty()) { fail("sortie introuvable"); return; }
        if (!Scen6528::write(m_dev, o.value("voie").toInt(), int(val), m_sim, &err)) { fail(o.value("nom").toString() + " : " + err); return; }
        stepDone(); return;
    }
    if (key == "attendre_entree_6528") {
        const QJsonObject o = find("entrees", st.value("cible"));
        if (o.isEmpty()) { fail("entrée introuvable"); return; }
        m_inVoie = o.value("voie").toInt(); m_expected = int(val);
        m_timeoutS = st.value("timeout_s").toDouble(10); m_continueOnTimeout = st.value("sur_timeout").toString().startsWith("contin");
        m_pollClock.start(); m_poll.start(); return;
    }
    if (key == "attendre_duree") { m_wait.start(int(std::max(1.0, val * 1000))); return; }
    // alimentations
    EaPsu* p = psu(ScenarioModel::idText(st.value("cible")), &err);
    if (!p) { fail(err); return; }
    QString cmd;
    if (key == "regler_tension") cmd = QString("VOLT %1").arg(val, 0, 'f', 2);
    else if (key == "regler_limite_courant") cmd = QString("CURR %1").arg(val, 0, 'f', 3);
    else if (key == "regler_limite_puissance") cmd = QString("POW %1").arg(val, 0, 'f', 1);
    else if (key == "activer_sortie_dc") cmd = "OUTP ON";
    else if (key == "desactiver_sortie_dc") cmd = "OUTP OFF";
    if (!p->command(cmd, &err)) { fail(err); return; }
    stepDone();
}

void ScenarioRunner::setAllOutputs(const char* field)
{
    for (const auto& v : m_auto.value("sorties").toArray()) {
        const QJsonObject o = v.toObject(); QString e;
        if (!Scen6528::write(m_dev, o.value("voie").toInt(), o.value(field).toInt(), m_sim, &e)) {
            emit logMessage("err", QString("Sortie « %1 » → %2 : %3").arg(o.value("nom").toString(), field, e));
            if (QString(field) == "initial") { fail("mise à l’état initial impossible"); return; }
        }
    }
}

void ScenarioRunner::safeStop()
{
    // 1. MLI des amplis du scenario  2. sorties DC de toutes les alimentations  3. sorties 6528 -> etat « arret »
    QString e;
    if (!m_sim && m_mli) for (int amp : m_amps) if (!m_mli(amp, "arreter_mli", &e)) emit logMessage("err", QString("Arrêt MLI ampli %1 : %2").arg(amp).arg(e));
    for (const auto& v : m_auto.value("alimentations").toArray()) {
        const QString id = ScenarioModel::idText(v.toObject().value("id"));
        if (EaPsu* p = psu(id, &e)) { if (!p->command("OUTP OFF", &e)) emit logMessage("err", e); }
        else emit logMessage("err", "Coupure sortie DC : " + e);
    }
    for (auto& p : m_psus) p->close();
    m_psus.clear();
    for (const auto& v : m_auto.value("sorties").toArray()) {
        const QJsonObject o = v.toObject();
        if (!Scen6528::write(m_dev, o.value("voie").toInt(), o.value("arret").toInt(), m_sim, &e)) emit logMessage("err", QString("Sortie « %1 » → arrêt : %2").arg(o.value("nom").toString(), e));
    }
}

void ScenarioRunner::fail(const QString& msg)
{
    if (!m_running) return;
    m_wait.stop(); m_poll.stop();
    emit logMessage("err", QString("Scénario « %1 », étape %2 : %3 — mise en sécurité").arg(m_name).arg(m_k + 1).arg(msg));
    safeStop();
    m_running = false; const int k = m_k; m_k = -1;
    emit finished(false, QString("Étape %1 : %2").arg(k + 1).arg(msg));
}

void ScenarioRunner::stop(const QString& why)
{
    if (!m_running) return;
    m_wait.stop(); m_poll.stop();
    emit logMessage("warn", QString("Scénario « %1 » arrêté (%2) — mise en sécurité").arg(m_name, why));
    safeStop();
    m_running = false; m_k = -1;
    emit finished(false, "Scénario arrêté : " + why);
}






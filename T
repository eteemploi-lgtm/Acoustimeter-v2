// v58 : emission d'un ensemble d'amplis (vide = tous) -- utilise par « Démarrer émission » et par les scenarios
bool MainWindow::startEmissionFor(const QSet<int>& only, QString* errOut)
{
    const bool bypass = m_noAmpCheck && m_noAmpCheck->isChecked();
    QVector<quint32> words; double clk = 0; QString err; QList<ConfigWindow::AbOutput> ab;
    QApplication::setOverrideCursor(Qt::WaitCursor);
    const bool okD = m_configWindow->buildMliLines(&words, &clk, &err, true, only);
    const bool okAB = okD && m_configWindow->buildAnalogOutputs(&ab, &err, only);
    QApplication::restoreOverrideCursor();
    if (!okD || !okAB) { *errOut = err; return false; }
    if (words.isEmpty() && ab.isEmpty()) { *errOut = "aucun ampli configuré (choisissez la classe AB ou D de chaque ampli)."; return false; }
    if (m_connConfig.offline) { *errOut = "mode hors ligne"; return false; }
    if (bypass) appendLog("warn", "Émission en mode TEST OSCILLO SANS AMPLI SOUS TENSION : surveillance thermique ignorée");
    m_supEmitAmps.clear();
    for (const auto& a : m_cfg.amplifiers) if (only.isEmpty() || only.contains(a.id)) m_supEmitAmps << a.id;
    QStringList what;
    if (!words.isEmpty()) {
        appendLog("info", QString("Émission classe D : %1 échantillons à %2 MHz envoyés à la PXIe-6537").arg(words.size()).arg(clk / 1e6, 0, 'g', 6));
        m_hw->startLines(words, clk, bypass); noteMli(words, clk); what << "classe D (6537)";
    }
    if (ab.size() == 1) {
        const auto& o = ab.first();
        appendLog("info", QString("Émission classe AB : ampli %1 sur ao%2 (±%3 V crête, %4)").arg(o.amp).arg(o.channel).arg(o.peak, 0, 'g', 5).arg(o.highZ ? "charge à vide" : "50 Ω"));
        m_supAbPending = true; m_hw->startFgen(o.x, o.fs, o.channel, o.highZ, o.peak, bypass); what << QString("AB ampli %1 (ao%2)").arg(o.amp).arg(o.channel);
    } else if (ab.size() == 2) {
        // deux voies : meme cadence pour la carte -> reechantillonnage lineaire a la cadence la plus haute
        const ConfigWindow::AbOutput& a0 = ab[0].channel == "0" ? ab[0] : ab[1];
        const ConfigWindow::AbOutput& a1 = ab[0].channel == "0" ? ab[1] : ab[0];
        const double fs = std::max(a0.fs, a1.fs);
        auto rs = [fs](const QVector<float>& x, double f0) {
            if (std::abs(f0 - fs) < 1e-9 * fs || x.size() < 2) return x;
            const int m = std::max(2, int(std::lround(x.size() * fs / f0))); QVector<float> y(m);
            for (int j = 0; j < m; ++j) { const double t = j * f0 / fs; const int n0 = int(x.size()); const int k = std::min(int(t), n0 - 1), k1 = (k + 1) % n0; const double w = t - k; y[j] = float(x[k] * (1 - w) + x[k1] * w); }
            return y; };
        appendLog("info", QString("Émission classe AB : ampli %1 sur ao0 et ampli %2 sur ao1, cadence commune %3 Hz").arg(a0.amp).arg(a1.amp).arg(fs, 0, 'g', 7));
        m_supAbPending = true; m_hw->startFgenDual(rs(a0.x, a0.fs), rs(a1.x, a1.fs), fs, a0.highZ, a1.highZ, a0.peak, a1.peak, bypass);
        what << QString("AB amplis %1 (ao0) et %2 (ao1)").arg(a0.amp).arg(a1.amp);
    }
    recEvent("mli_play", "Démarrer émission : " + what.join(" + "));
    updateEmitButton();
    startMeasures();
    return true;
}

// v58 : MLI pilotees par un scenario. Les amplis classe D partagent la PXIe-6537 : on reemet l'ensemble des amplis actifs.
bool MainWindow::scenarioMli(int amp, const QString& action, QString* err)
{
    if (action == "demarrer_mli" || action == "reprendre_mli") m_scenAmps << amp; else m_scenAmps.remove(amp);
    if (m_hw->emitting()) m_hw->stopEmission();
    if (m_supAbOn || m_supAbPending) { if (!m_connConfig.offline) m_hw->stopFgen("scénario"); m_supAbOn = m_supAbPending = false; }
    m_supEmitAmps.clear();
    if (m_scenAmps.isEmpty()) { updateEmitButton(); refreshSidebarStatus(); appendLog("info", QString("Scénario : MLI ampli %1 — %2").arg(amp).arg(action)); return true; }
    const bool ok = startEmissionFor(m_scenAmps, err);
    if (ok) appendLog("info", QString("Scénario : MLI ampli %1 — %2 (amplis émis : %3)").arg(amp).arg(action)
                                  .arg([this]() { QStringList l; for (int a : m_scenAmps) l << QString::number(a); return l.join(", "); }()));
    return ok;
}


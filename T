namespace {
QMap<int, int> g_simOut;          // etat des sorties en simulation
#if defined(ACOUSTIMETER_WITH_NI)
bool chk(int e, const char* where, QString* err)
{
    if (e >= 0) return true;
    char buf[2048] = {0}; DAQmxGetExtendedErrorInfo(buf, sizeof(buf));
    if (err) *err = QString("DAQmx [%1] %2 : %3").arg(where).arg(e).arg(QString::fromLocal8Bit(buf));
    return false;
}
#endif
}

QString Scen6528::inputLine(const QString& dev, int v)  { return QString("%1/port%2/line%3").arg(dev.trimmed()).arg(v / 8).arg(v % 8); }
QString Scen6528::outputLine(const QString& dev, int v) { return QString("%1/port%2/line%3").arg(dev.trimmed()).arg(3 + v / 8).arg(v % 8); }

bool Scen6528::write(const QString& dev, int voie, int value, bool simulate, QString* err)
{
    if (voie < 0 || voie > 23) { if (err) *err = QString("voie de sortie %1 hors de 0…23").arg(voie); return false; }
    if (simulate) { g_simOut[voie] = value ? 1 : 0; return true; }
#if defined(ACOUSTIMETER_WITH_NI)
    TaskHandle t = nullptr; uInt8 v = value ? 1 : 0; int32 wr = 0;
    const QByteArray line = outputLine(dev, voie).toLocal8Bit();
    const bool ok = chk(DAQmxCreateTask("", &t), "CreateTask", err)
                 && chk(DAQmxCreateDOChan(t, line.constData(), "", DAQmx_Val_ChanPerLine), "CreateDOChan", err)
                 && chk(DAQmxWriteDigitalLines(t, 1, 1, 2.0, DAQmx_Val_GroupByChannel, &v, &wr, nullptr), "WriteDigitalLines", err);
    if (t) { DAQmxStopTask(t); DAQmxClearTask(t); }      // le 6528 garde l'etat de ses sorties
    return ok;
#else
    Q_UNUSED(dev); if (err) *err = "NI-DAQmx absent de cette compilation : cochez « Simulation »"; return false;
#endif
}

bool Scen6528::read(const QString& dev, int voie, int* value, bool simulate, QString* err)
{
    if (voie < 0 || voie > 23) { if (err) *err = QString("voie d’entrée %1 hors de 0…23").arg(voie); return false; }
    if (simulate) { *value = -1; return true; }           // -1 : l'appelant simule l'arrivee de l'etat attendu
#if defined(ACOUSTIMETER_WITH_NI)
    TaskHandle t = nullptr; uInt8 v = 0; int32 rd = 0, bpc = 0;
    const QByteArray line = inputLine(dev, voie).toLocal8Bit();
    const bool ok = chk(DAQmxCreateTask("", &t), "CreateTask", err)
                 && chk(DAQmxCreateDIChan(t, line.constData(), "", DAQmx_Val_ChanPerLine), "CreateDIChan", err)
                 && chk(DAQmxReadDigitalLines(t, 1, 2.0, DAQmx_Val_GroupByChannel, &v, 1, &rd, &bpc, nullptr), "ReadDigitalLines", err);
    if (t) { DAQmxStopTask(t); DAQmxClearTask(t); }
    if (ok) *value = v ? 1 : 0;
    return ok;
#else
    Q_UNUSED(dev); if (err) *err = "NI-DAQmx absent de cette compilation : cochez « Simulation »"; return false;
#endif
}

// ----------------------------------------------------------------------------- alimentation EA (SCPI)
bool EaPsu::open(const QString& port, bool simulate, QString* err)
{
    close(); m_port = port.trimmed(); m_sim = simulate;
    if (m_port.isEmpty()) { if (err) *err = "connexion USB (port COM) non renseignée"; return false; }
    if (m_sim) { m_open = true; return true; }
#if defined(_WIN32)
    const std::wstring path = (QString("\\\\.\\") + m_port).toStdWString();
    HANDLE h = CreateFileW(path.c_str(), GENERIC_READ | GENERIC_WRITE, 0, nullptr, OPEN_EXISTING, 0, nullptr);
    if (h == INVALID_HANDLE_VALUE) { if (err) *err = QString("%1 : ouverture impossible (erreur Windows %2)").arg(m_port).arg(GetLastError()); return false; }
    DCB dcb{}; dcb.DCBlength = sizeof(dcb); GetCommState(h, &dcb);
    dcb.BaudRate = 115200; dcb.ByteSize = 8; dcb.Parity = NOPARITY; dcb.StopBits = ONESTOPBIT;   // port USB virtuel : debit indifferent
    dcb.fDtrControl = DTR_CONTROL_ENABLE; dcb.fRtsControl = RTS_CONTROL_ENABLE;
    SetCommState(h, &dcb);
    COMMTIMEOUTS to{}; to.ReadIntervalTimeout = 50; to.ReadTotalTimeoutConstant = 500; to.WriteTotalTimeoutConstant = 500;
    SetCommTimeouts(h, &to);
    m_h = h; m_open = true;
    QString id; const QString idn = query("*IDN?", &id);
    if (idn.isEmpty()) { const QString e = id; close(); if (err) *err = QString("%1 : l’alimentation ne répond pas à *IDN? (%2)").arg(m_port, e); return false; }
    return command("SYST:LOCK ON", err);                  // commande a distance
#else
    if (err) *err = "pilotage des alimentations disponible sous Windows uniquement : cochez « Simulation »"; return false;
#endif
}

void EaPsu::close()
{
    if (!m_open) return;
#if defined(_WIN32)
    if (!m_sim && m_h) { QString e; writeLine("SYST:LOCK OFF", &e); CloseHandle(HANDLE(m_h)); }
#endif
    m_h = nullptr; m_open = false;
}

bool EaPsu::writeLine(const QString& s, QString* err)
{
#if defined(_WIN32)
    const QByteArray b = (s + "\n").toLatin1(); DWORD n = 0;
    if (!WriteFile(HANDLE(m_h), b.constData(), DWORD(b.size()), &n, nullptr) || n != DWORD(b.size())) {
        if (err) *err = QString("%1 : écriture impossible").arg(m_port); return false; }
    return true;
#else
    Q_UNUSED(s); Q_UNUSED(err); return false;
#endif
}

bool EaPsu::readLine(QString* line, QString* err)
{
#if defined(_WIN32)
    QByteArray acc; char c = 0; DWORD n = 0; QElapsedTimer t; t.start();
    while (t.elapsed() < 1500) {
        if (!ReadFile(HANDLE(m_h), &c, 1, &n, nullptr)) break;
        if (n == 0) continue;
        if (c == '\n') { *line = QString::fromLatin1(acc).trimmed(); return true; }
        acc += c;
    }
    if (err) *err = QString("%1 : pas de réponse").arg(m_port);
    return false;
#else
    Q_UNUSED(line); Q_UNUSED(err); return false;
#endif
}

QString EaPsu::query(const QString& scpi, QString* err)
{
    if (!m_open) { if (err) *err = "alimentation non connectée"; return QString(); }
    if (m_sim) return "simulation";
    QString r; if (!writeLine(scpi, err) || !readLine(&r, err)) return QString();
    return r;
}

bool EaPsu::command(const QString& scpi, QString* err)
{
    if (!m_open) { if (err) *err = "alimentation non connectée"; return false; }
    if (m_sim) return true;
    if (!writeLine(scpi, err)) return false;
    const QString e = query("SYST:ERR?", err);           // « 0,No error » attendu
    if (e.isEmpty()) return false;
    if (!e.startsWith("0")) { if (err) *err = QString("%1 refusé par l’alimentation : %2").arg(scpi, e); return false; }
    return true;
}



